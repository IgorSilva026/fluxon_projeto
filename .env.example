# Supabase > Connect > Session pooler
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASS=
DB_SSLMODE=require

# Ajuste se a pasta ou a porta do Apache for diferente.
APP_BASE_URL=http://localhost/fluxon_projeto-main/index.php

# SMTP para verificação de conta, código de acesso e recuperação.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Opcional: login com Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
